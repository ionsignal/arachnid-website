---
import { resolveLinkAttributes } from "@/utils/core";

interface NavigationButtonData {
  url?: string;
  rel?: string;
  target?: string;
}

interface Props {
  navigationButton: NavigationButtonData;
  label: string;
}

const { navigationButton, label } = Astro.props;
const linkAttributes = resolveLinkAttributes(
  navigationButton.url,
  navigationButton.rel,
  navigationButton.target,
);
---

<a
  {...linkAttributes}
  data-content={label}
  class="btn btn-primary has-text-flip-animation relative inline-flex items-center">
  {label}
</a>
