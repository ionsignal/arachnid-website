---
import LucideIcon from "@/components/helpers/LucideIcon.astro";
---

<button
  type="button"
  aria-label="Toggle navigation"
  aria-expanded="false"
  data-hs-collapse="#nav-menu"
  aria-controls="nav-menu"
  class="nav-toggler hs-collapse-toggle group hs-collapse-open:bg-white/5 focus-visible:ring-primary/60 relative flex h-10 w-10 touch-manipulation items-center justify-center border border-transparent text-white transition-colors duration-200 hover:border-white/10 hover:bg-white/5 focus-visible:ring-2 focus-visible:outline-none lg:hidden">
  <LucideIcon
    icon="Menu"
    class="hs-collapse-open:rotate-90 hs-collapse-open:scale-75 hs-collapse-open:opacity-0 absolute h-5 w-5 transition-all duration-300"
    aria-hidden="true"
  />
  <LucideIcon
    icon="X"
    class="hs-collapse-open:rotate-0 hs-collapse-open:scale-100 hs-collapse-open:opacity-100 absolute h-5 w-5 scale-75 -rotate-90 opacity-0 transition-all duration-300"
    aria-hidden="true"
  />
</button>
